# This file documents the non-secret production shape. The deployment script
# writes .env.production on the VM from Google Secret Manager; do not add real
# credentials to this file.
APP_NAME=OASIS
APP_ENV=production
DEBUG=false
SECRET_KEY=from-google-secret-manager

POSTGRES_USER=oasis
POSTGRES_PASSWORD=from-google-secret-manager
POSTGRES_DB=oasis
POSTGRES_HOST=cloud-sql-proxy
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
WEB_CONCURRENCY=2

REDIS_URL=redis://redis:6379/0
CLOUD_SQL_INSTANCE=project:region:instance
DOMAIN=203-0-113-10.sslip.io
SOURCE_CODE_URL=

OPENAI_API_KEY=from-google-secret-manager
OPENAI_USE_EU=false

AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=from-google-secret-manager

# Audio remains disabled per agent for the current Prolific pilot.
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_LOCAL_PATH=/data/oasis-recordings
